{
    "name": "wieslawgolec/plugin-logokit",
    "description": "LogoKit (Clearbit replacement) plugin for Mautic 7.2+ — company & contact enrichment via LogoKit Brand + Logo APIs, with Clearbit data import support",
    "type": "mautic-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Wieslaw Golec"
        }
    ],
    "require": {
        "php": "^8.1",
        "mautic/core-lib": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "doctrine/dbal": "^3.0 || ^4.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "extra": {
        "mautic-plugin-name": "LogokitBundle",
        "install-directory-name": "LogokitBundle"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\LogokitBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\LogokitBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}
